# Firebase keys. Copy to `.env.local` and fill in.
# The JSON object from Firebase console > Project settings > Your apps.
VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
# reCAPTCHA Enterprise site key for App Check. Required for a hosted demo.
VITE_APP_CHECK_SITE_KEY=
